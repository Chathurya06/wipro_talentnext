package java_fundamentals;
import java.util.*;

public class ArraysQ12 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc = new Scanner(System.in);

        int[] a = new int[3];
        System.out.println("Enter 3 integers for array a:");
        for (int i = 0; i < 3; i++) {
            a[i] = sc.nextInt();
        }
        int[] b = new int[3];
        System.out.println("Enter 3 integers for array b:");
        for (int i = 0; i < 3; i++) {
            b[i] = sc.nextInt();
        }
        int[] result = {a[1], b[1]};
        System.out.println("Middle elements array: " + Arrays.toString(result));

        sc.close();
    }
}
